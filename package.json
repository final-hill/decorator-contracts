{
    "name": "@final-hill/decorator-contracts",
    "version": "3.0.0",
    "description": "Code Contracts for TypeScript and ECMAScript classes",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "types": "./dist/index.d.mts",
    "main": "./dist/index.mjs",
    "scripts": {
        "prebuild": "npm run lint",
        "build": "webpack",
        "lint": "eslint src '**/*.md' eslint.config.js webpack.config.mjs --ignore-pattern node_modules --ignore-pattern dist --max-warnings 0",
        "lint:fix": "eslint src '**/*.md' eslint.config.js webpack.config.mjs --ignore-pattern node_modules --ignore-pattern dist --fix",
        "pretest": "npm run build && npm run typecheck",
        "test": "globstar -- node --import tsx --test ./src/tests/*.test.mts",
        "pretest:coverage": "npm run build && node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
        "test:coverage": "globstar -- node --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info ./src/tests/*.test.mts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
    },
    "homepage": "https://github.com/final-hill/decorator-contracts#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/final-hill/decorator-contracts.git"
    },
    "bugs": {
        "url": "https://github.com/final-hill/decorator-contracts/issues"
    },
    "keywords": [
        "assertion",
        "biconditional",
        "behavioral-subtyping",
        "code-contracts",
        "decorators",
        "demands",
        "design-by-contract",
        "encapsulation",
        "exception-handling",
        "if-and-only-if",
        "invariant",
        "liskov-substitution-principle",
        "LSP",
        "material-implication",
        "organized-panic",
        "precondition",
        "postcondition",
        "rescue",
        "requires",
        "SOLID"
    ],
    "engines": {
        "node": ">=26"
    },
    "author": "Michael L Haufe <michael.haufe@final-hill.com> (https://final-hill.com)",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^9.0.0",
        "@types/node": "^26.6.6",
        "eslint": "^10.15.0",
        "eslint-webpack-plugin": "^6.0.0",
        "globals": "^17.14.0",
        "globstar": "^1.0.0",
        "ts-loader": "^9.6.2",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "webpack": "^5.113.0",
        "webpack-cli": "^7.3.1"
    },
    "files": [
        "dist"
    ],
    "overrides": {
        "katex": "^0.19.1"
    }
}
